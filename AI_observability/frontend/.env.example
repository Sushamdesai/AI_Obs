# Keep the browser connected to the FastAPI service only.
# Vite proxies /api to the local API during development.
VITE_API_BASE_URL=/api/v1
VITE_API_ORIGIN=http://127.0.0.1:8000
VITE_REFRESH_INTERVAL_MS=15000

# Contract-matching static fixtures are only enabled by explicit opt-in.
VITE_DEMO_MOCKS=false
