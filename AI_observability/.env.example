# Local/demo environment settings. Blank provider credentials mean NOT_CONFIGURED.
APP_ENV=demo
APP_NAME=InsuraObserve AI
LOG_LEVEL=INFO
DEMO_MODE=true

# Core mode selection
DATA_PLATFORM_PROVIDER=local
OBSERVABILITY_PROVIDER=local
LLM_PROVIDER=deterministic

# PostgreSQL URL for shared metadata. Blank uses local .local/metadata.sqlite3 fallback.
DATABASE_URL=
LOCAL_DATA_PATH=.local/insuraobserve.sqlite3
SIMULATOR_BATCH_SIZE=12
SIMULATOR_INTERVAL_SECONDS=5

# Databricks integration (optional; leave blank unless configured)
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=insurance_observability

# Dynatrace integration (optional; leave blank unless configured)
DYNATRACE_ENABLED=false
DYNATRACE_ENVIRONMENT_ID=
DYNATRACE_API_TOKEN=
DYNATRACE_URL=

# OpenTelemetry / vendor-neutral telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=insuraobserve

# Gemini (optional; not a hard dependency)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Runtime uses UTC internally; local timezone is not configurable.
